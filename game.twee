    demoClose: { en: "Back to the office", ja: "オフィスに戻る" },
    storeTag: { en: "APP STORE", ja: "アプリストア" },
    storeTask: { en: "What users are saying about LearnLoop", ja: "LearnLoop への利用者の声" },
    storeSub: { en: "Education · Subscription", ja: "教育・サブスクリプション" },
    storeHeading: { en: "Ratings & Reviews", ja: "評価とレビュー" },
    trendUp: { en: "▲ Trending up", ja: "▲ 上昇中" },
    trendDown: { en: "▼ Trending down", ja: "▼ 下降中" },
    storeClose: { en: "Put the phone down", ja: "スマホを置く" }
  };

  // 利用者の視点で体験する解約手続き（ルートごとに別のダークパターン）
  var DEMOS = {};
  // Implement ルート：解約の入口を隠し、引き止めを重ね、完了も曖昧にする
  DEMOS["cancel-demo"] = { tag: UI.demoTag, task: UI.demoTask, question: UI.demoQuestion,
    log: { en: "Tried Jordan’s cancel flow", ja: "Jordan の解約手続きを体験" }, screens: [
    { title: { en: "Account", ja: "アカウント" }, items: [
      { label: { en: "Profile", ja: "プロフィール" }, toast: { en: "Only Jordan’s name and photo are here.", ja: "名前と写真の設定しかない。" } },
      { label: { en: "Notifications", ja: "通知" }, toast: { en: "Just email and push settings.", ja: "メールとプッシュ通知の設定だけだ。" } },
      { label: { en: "Learning goals", ja: "学習目標" }, toast: { en: "Weekly study targets. No way to cancel here.", ja: "週ごとの学習目標。解約はここにもない。" } },
      { label: { en: "Billing & plan", ja: "お支払いとプラン" }, go: 1 }
    ] },
    { title: { en: "Billing & plan", ja: "お支払いとプラン" },
      card: { en: "Monthly plan · $14.99 · Renews Nov 1", ja: "月額プラン・1,980円・11月1日に更新" },
      heading: { en: "Upgrade to Annual and save 40%!", ja: "年額プランなら40%お得！" },
      primary: { label: { en: "Upgrade to Annual", ja: "年額プランにアップグレード" }, toast: { en: "That would sign Jordan up for a whole year!", ja: "それでは1年分の契約になってしまう！" } },
      link: { label: { en: "Other options", ja: "その他のオプション" }, go: 2 } },
    { title: { en: "Before you go…", ja: "その前に……" },
      heading: { en: "Wait! Don’t lose your progress.", ja: "お待ちください！ 学習の記録が失われます。" },
      text: { en: "Get 50% off for the next 3 months.", ja: "今なら3か月間50%オフ。" },
      primary: { label: { en: "Claim my discount", ja: "割引を受け取る" }, toast: { en: "That keeps the subscription going.", ja: "それでは契約が続いてしまう。" } },
      link: { label: { en: "No thanks, continue", ja: "いいえ、続ける" }, go: 3 } },
    { title: { en: "Need a break?", ja: "少し休みませんか？" },
      heading: { en: "Pause instead of leaving", ja: "解約ではなく休会しませんか" },
      text: { en: "Keep your streak and certificates. Pause for up to 3 months.", ja: "連続記録と修了証はそのまま。最大3か月休会できます。" },
