    { key: "runway", label: { en: "Company runway", ja: "会社の余力" }, color: "#f0b54a", icon: "runway" },
    { key: "team", label: { en: "Team trust", ja: "チームの信頼" }, color: "#8ea2ff", icon: "team" }
  ];
  var ICONS = {
