      card: { en: "Plan status: Active · Renews Nov 1", ja: "プランの状態：有効・11月1日に更新" },
      primary: { label: { en: "Back to home", ja: "ホームに戻る" }, done: true } }
  ] };
  // AlternativePressure ルート：入口は見えるが、休会への誘導と罪悪感をあおる断り文句が続く
  DEMOS["pressure-demo"] = {
