    question: { en: "The cancel button was easy to find, and canceling did work. But every screen pushed you toward “pause.” Was that a free choice?",
                ja: "解約ボタンは見つけやすく、解約もできた。でも、どの画面も「休会」へ誘導していた。これは自由な選択だった？" },
    log: { en: "Tried the new cancel flow", ja: "新しい解約手続きを体験" }, screens: [
    { title: { en: "Account", ja: "アカウント" }, items: [
      { label: { en: "Profile", ja: "プロフィール" }, toast: { en: "Only a name and photo here.", ja: "名前と写真の設定しかない。" } },
      { label: { en: "Notifications", ja: "通知" }, toast: { en: "Just email and push settings.", ja: "メールとプッシュ通知の設定だけだ。" } },
      { label: { en: "Billing & plan", ja: "お支払いとプラン" }, toast: { en: "Just the payment card on file.", ja: "支払いカードの情報だけだ。" } },
      { label: { en: "Cancel subscription", ja: "サブスクリプションを解約" }, go: 1 }
    ] },
    { title: { en: "Cancel subscription", ja: "サブスクリプションの解約" },
      heading: { en: "Wait! Pause instead and keep everything.", ja: "お待ちください！ 休会すれば、すべてそのままです。" },
      text: { en: "Your 42-day streak, notes, and certificates stay safe while you’re away.", ja: "42日間の連続記録、ノート、修了証はそのまま保存されます。" },
      primary: { label: { en: "Pause for 3 months (free)", ja: "3か月無料で休会する" }, toast: { en: "Pausing isn’t canceling.", ja: "休会は解約ではない。" } },
      link: { label: { en: "No thanks, I don’t care about my progress", ja: "いいえ、学習の記録はどうでもいいです" }, go: 2 } },
    { title: { en: "Are you sure?", ja: "本当によろしいですか？" },
      heading: { en: "You’ll lose your 42-day streak forever.", ja: "42日間の連続記録が完全に失われます。" },
      text: { en: "Most learners who pause come back within a month.", ja: "休会した人の多くは、1か月以内に戻ってきています。" },
      primary: { label: { en: "Keep my streak and pause", ja: "記録を守って休会する" }, toast: { en: "Another pause button…", ja: "また休会のボタンだ……" } },
      link: { label: { en: "Cancel anyway", ja: "それでも解約する" }, go: 3 } },
    { title: { en: "Last chance", ja: "最後のご案内" },
      heading: { en: "Special offer: 3 months free, then 50% off.", ja: "特別オファー：3か月無料、その後50%オフ。" },
      primary: { label: { en: "Accept offer", ja: "オファーを受け取る" }, toast: { en: "Still not canceling.", ja: "これも解約ではない。" } },
      link: { label: { en: "Decline offer and cancel", ja: "オファーを断って解約する" }, go: 4 } },
    { title: { en: "Canceled", ja: "解約完了" },
      heading: { en: "Your subscription has been canceled.", ja: "サブスクリプションを解約しました。" },
      card: { en: "Plan ends Nov 1 · You won’t be charged again", ja: "11月1日でプラン終了・今後の請求はありません" },
      primary: { label: { en: "Done", ja: "完了" }, done: true } }
  ] };
  var TONES = {
