    team: '<circle cx="9" cy="9" r="3"/><circle cx="16.5" cy="10" r="2.5"/><path d="M3 19c0-3 2.7-5 6-5s6 2 6 5M15.5 14.5c2.8 0 5 1.6 5 4.5"/>',
    bell: '<path d="M6 16v-5a6 6 0 0 1 12 0v5l2 2H4z"/><path d="M10 20a2 2 0 0 0 4 0"/>',
    bulb: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/>',
    log: '<path d="M5 6h14M5 12h14M5 18h9"/>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>'
  };

  var reduceMotion = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  var S = { mode: "idle", passage: null, lines: [], i: -1, typing: false, timer: 0, chapterTimer: 0,
            full: null, talker: null, cast: [], stats: null, log: [], choices: null, ending: null, demoTaps: 7 };
  var lang = "en";
  try { lang = localStorage.getItem(LANG_KEY) === "ja" ? "ja" : "en"; } catch (e) { /* 既定の英語のまま */ }

  function svg(name) {
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + ICONS[name] + "</svg>";
  }
  function el(tag, cls, html) {
    var node = document.createElement(tag);
    if (cls) { node.className = cls; }
    if (html != null) { node.innerHTML = html; }
    return node;
  }
  function esc(text) {
    return String(text).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; });
  }
  // 両言語のテキストを並べ、表示する言語は CSS で切り替える
  function L(pair) {
    return '<span lang="en">' + esc(pair.en) + '</span><span lang="ja">' + esc(pair.ja) + "</span>";
  }
  function textPair(node) {
    function pick(code) {
      var part = node.querySelector('[lang="' + code + '"]');
      return (part || node).textContent.trim();
    }
    return { en: pick("en"), ja: pick("ja") };
  }
  function words(text) { return (text || "").split(/\s+/).filter(Boolean); }
  function clamp(n) { return Math.max(0, Math.min(100, n)); }

  // ---- 常設レイヤー（背景・立ち絵・会話ウィンドウ） ----
  var body = document.body;
  var stage = el("div", "vn-stage");
  var bgs = [el("div", "vn-bg"), el("div", "vn-bg")];
  var bgIndex = 0;
  var castEl = el("div", "vn-cast");
  stage.appendChild(bgs[0]);
  stage.appendChild(bgs[1]);
  stage.appendChild(castEl);
  stage.appendChild(el("div", "vn-shade"));

  var ui = el("div", "vn-ui",
    '<div class="vn-hud"><div class="vn-scene-tag"><span class="vn-day"></span><span class="vn-place"></span></div>' +
    '<div class="vn-hud-right"><div class="vn-meters"></div><button type="button" class="vn-log-btn" title="Log (L)">' + svg("log") + "<span>" + L(UI.log) + "</span></button></div></div>" +
    '<div class="vn-chapter"><div class="vn-chapter-inner"><p class="vn-chapter-day"></p><p class="vn-chapter-title"></p></div></div>' +
    '<div class="vn-box is-hidden"><div class="vn-face" aria-hidden="true"></div>' +
    '<div class="vn-plate"><span class="vn-plate-icon"></span><span class="vn-name"></span><small class="vn-role"></small></div>' +
    '<p class="vn-text" aria-hidden="true"></p><p class="vn-sr" aria-live="polite"></p>' +
    '<div class="vn-next"><span>' + L(UI.next) + "</span><b>▼</b></div></div>");
  var meters = ui.querySelector(".vn-meters");
  STATS.forEach(function (s) {
    var m = el("div", "vn-meter",
      '<div class="vn-meter-top"><span class="vn-meter-icon">' + svg(s.icon) + '</span><span class="vn-meter-label">' + L(s.label) +
      '</span><b class="vn-meter-value">0</b></div><div class="vn-meter-bar"><i></i></div><em class="vn-delta"></em>');
    m.dataset.stat = s.key;
    m.style.setProperty("--c", s.color);
    meters.appendChild(m);
  });
  var box = ui.querySelector(".vn-box");
  var textEl = ui.querySelector(".vn-text");
  var srEl = ui.querySelector(".vn-sr");
  var chapter = ui.querySelector(".vn-chapter");

  var logPanel = el("div", "vn-log",
    '<div class="vn-log-card" role="dialog" aria-label="Dialogue log"><div class="vn-log-head"><h2>' + L(UI.logTitle) + "</h2>" +
    '<button type="button" class="vn-log-close">' + L(UI.close) + '</button></div><ol class="vn-log-list"></ol></div>');
  logPanel.hidden = true;

  var langSwitch = el("div", "vn-lang",
    '<button type="button" data-lang="en">EN</button><button type="button" data-lang="ja">日本語</button>');
  langSwitch.setAttribute("role", "group");
  langSwitch.setAttribute("aria-label", "Language / 言語");

  body.insertBefore(stage, body.firstChild);
  body.appendChild(ui);
  body.appendChild(logPanel);
  body.appendChild(langSwitch);
  Object.keys(CAST).forEach(function (id) { new Image().src = CAST[id].img; });

  // ---- 言語 ----
  function setLang(next) {
    lang = next === "ja" ? "ja" : "en";
    document.documentElement.setAttribute("data-lang", lang);
    document.documentElement.lang = lang;
    try { localStorage.setItem(LANG_KEY, lang); } catch (e) { /* 保存できなくても切り替えは続ける */ }
    Array.prototype.forEach.call(langSwitch.querySelectorAll("button"), function (b) {
      b.setAttribute("aria-pressed", String(b.dataset.lang === lang));
    });
    if (S.full) {
      if (S.typing) { finishTyping(); } else { textEl.textContent = S.full[lang]; }
      srEl.textContent = S.full[lang];
    }
  }
  langSwitch.addEventListener("click", function (e) {
    var b = e.target.closest("button");
    if (b) { setLang(b.dataset.lang); }
  });
  setLang(lang);

  // ---- 背景と立ち絵 ----
  function setBg(name) {
    if (bgs[bgIndex].dataset.bg === name) { return; }
    bgs[bgIndex].classList.remove("is-active");
    bgIndex = 1 - bgIndex;
    bgs[bgIndex].dataset.bg = name;
    bgs[bgIndex].classList.add("is-active");
  }

  function spriteOf(id) {
    return castEl.querySelector('.vn-sprite[data-id="' + id + '"]:not(.is-leaving)');
  }

  function setCast(ids, title) {
    S.cast = ids.slice();
    var pos = title ? ["t1", "t2", "t3"] : ids.length === 1 ? ["center"] : ids.length === 2 ? ["left", "right"] : ["l3", "c3", "r3"];
    Array.prototype.forEach.call(castEl.children, function (sp) {
      if (ids.indexOf(sp.dataset.id) < 0 && !sp.classList.contains("is-leaving")) {
        sp.classList.add("is-leaving");
        sp.classList.remove("is-speaking", "is-talking");
        setTimeout(function () { if (sp.classList.contains("is-leaving")) { sp.remove(); } }, 650);
      }
    });
    ids.forEach(function (id, n) {
      var sp = castEl.querySelector('.vn-sprite[data-id="' + id + '"]');
      if (!sp) {
        sp = el("div", "vn-sprite is-leaving", '<div class="vn-sprite-motion"><img alt="' + esc(CAST[id].name.en) + '" src="' + CAST[id].img + '"></div>');
        sp.dataset.id = id;
        sp.dataset.pos = pos[n];
        castEl.appendChild(sp);
        void sp.offsetWidth;
      }
      sp.style.setProperty("--delay", title ? (n * 0.18) + "s" : "0s");
      sp.dataset.pos = pos[n];
      sp.classList.remove("is-leaving");
    });
  }

  function setSpeaker(id) {
    castEl.classList.toggle("has-speaker", !!id);
    Array.prototype.forEach.call(castEl.children, function (sp) {
      sp.classList.toggle("is-speaking", sp.dataset.id === id);
    });
  }

  // ---- 指標 ----
  function readStats(passage) {
    var data = passage.querySelector(".vn-hud-data");
    if (!data) { return; }
    var next = {};
    STATS.forEach(function (s) {
      var node = data.querySelector('[data-stat="' + s.key + '"]');
      next[s.key] = node ? Number(node.textContent) || 0 : 0;
      var m = meters.querySelector('[data-stat="' + s.key + '"]');
      m.querySelector(".vn-meter-value").textContent = next[s.key];
      m.querySelector(".vn-meter-bar i").style.width = clamp(next[s.key]) + "%";
      var delta = S.stats ? next[s.key] - S.stats[s.key] : 0;
      var chip = m.querySelector(".vn-delta");
      chip.className = "vn-delta";
      if (delta) {
        chip.textContent = (delta > 0 ? "+" : "") + delta;
        void chip.offsetWidth;
        chip.className = "vn-delta is-shown " + (delta > 0 ? "is-up" : "is-down");
      }
    });
    S.stats = next;
  }

  // ---- 選択肢とエンディングの装飾 ----
  function decorateChoices(wrap) {
    if (wrap.dataset.ready) { return; }
    wrap.dataset.ready = "1";
    var prompt = { en: wrap.dataset.promptEn || UI.prompt.en, ja: wrap.dataset.promptJa || UI.prompt.ja };
    wrap.insertBefore(el("div", "vn-choice-prompt", "<span>" + L(prompt) + "</span>"), wrap.firstChild);
    Array.prototype.forEach.call(wrap.querySelectorAll(".vn-choice"), function (card, n) {
      var tone = TONES[card.dataset.tone] || TONES.balance;
      card.style.setProperty("--c", tone.color);
      card.style.setProperty("--i", n);
      card.setAttribute("role", "button");
      card.tabIndex = 0;
      var content = el("div", "vn-choice-body");
      Array.prototype.forEach.call(card.querySelectorAll(".vn-choice-tag, .vn-choice-title, .vn-choice-desc"), function (part) {
        content.appendChild(part);
      });
      card.insertBefore(el("span", "vn-choice-arrow", "›"), card.firstChild);
      card.insertBefore(content, card.firstChild);
      card.insertBefore(el("span", "vn-choice-icon", svg(tone.icon)), card.firstChild);
      card.insertBefore(el("span", "vn-choice-key", String(n + 1)), card.firstChild);
      card.addEventListener("click", function () { choose(card); });
    });
  }

  function seenEndings() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; } catch (e) { return []; }
  }
  function recordEnding(id) {
    var seen = seenEndings();
    if (seen.indexOf(id) < 0) { seen.push(id); }
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(seen)); } catch (e) { /* 保存できなくても表示は続ける */ }
    return seen;
  }

  function fillEnding(wrap) {
    var card = wrap.querySelector(".vn-ending-card");
    var actions = card.querySelector(".vn-ending-actions");
    var stats = card.querySelector(".vn-ending-stats") || card.insertBefore(el("div", "vn-ending-stats"), actions);
    var coll = card.querySelector(".vn-ending-collection") || card.insertBefore(el("div", "vn-ending-collection"), actions);
    stats.innerHTML = STATS.map(function (s) {
      var v = S.stats ? S.stats[s.key] : 0;
      return '<div class="vn-ending-stat" style="--c:' + s.color + '"><span>' + L(s.label) + '</span><div class="vn-meter-bar"><i style="width:' +
        clamp(v) + '%"></i></div><b>' + v + "</b></div>";
    }).join("");
    var seen = recordEnding(wrap.dataset.id);
    var dots = "";
    for (var n = 1; n <= ENDING_TOTAL; n++) {
      dots += '<i class="' + (seen.indexOf(String(n)) >= 0 ? "is-seen" : "") + (String(n) === wrap.dataset.id ? " is-current" : "") + '"></i>';
    }
    var count = " " + Math.min(seen.length, ENDING_TOTAL) + " / " + ENDING_TOTAL;
    var tail = seen.length < ENDING_TOTAL ? UI.more : UI.all;
    coll.innerHTML = '<div class="vn-dots">' + dots + "</div><span>" + L({ en: UI.found.en + count + tail.en, ja: UI.found.ja + count + tail.ja }) + "</span>";
  }

  // ---- 進行 ----
  function setupPassage(p) {
    clearTimeout(S.timer);
    clearTimeout(S.chapterTimer);
    S.typing = false;
    S.full = null;
    stage.classList.remove("is-dim");
    chapter.classList.remove("is-shown");
    Array.prototype.forEach.call(p.querySelectorAll(".vn-btn"), function (btn) {
      btn.tabIndex = 0;
      btn.setAttribute("role", "button");
    });
    var title = p.querySelector(".vn-title");
    var scene = p.querySelector(".vn-scene");
    if (title) {
      S.mode = "title";
      S.log = [];
      S.stats = null;
      body.classList.add("vn-on-title");
      box.classList.add("is-hidden");
      setBg("office");
      castEl.classList.add("is-title");
      setCast(["takahashi", "saeki", "you"], true);
      setSpeaker(null);
      return;
    }
    if (!scene) { return; }
    body.classList.remove("vn-on-title");
    castEl.classList.remove("is-title");
    readStats(p);
    setBg(scene.dataset.bg || "office");
    setCast(words(scene.dataset.cast));
    setSpeaker(null);
    S.lines = Array.prototype.map.call(scene.querySelectorAll(".vn-line"), function (line) {
      return { who: line.dataset.who || "", event: line.dataset.event || "", text: textPair(line),
               stage: line.hasAttribute("data-stage") ? words(line.dataset.stage) : null };
    });
    S.i = -1;
    S.scene = scene;
    S.choices = scene.querySelector(".vn-choices");
    S.ending = scene.querySelector(".vn-ending");
    if (S.choices) { decorateChoices(S.choices); }
    ui.querySelector(".vn-day").textContent = scene.dataset.day || "";
    ui.querySelector(".vn-place").textContent = scene.dataset.place || "";
    chapter.querySelector(".vn-chapter-day").textContent = [scene.dataset.day, scene.dataset.place].filter(Boolean).join(" ・ ");
    chapter.querySelector(".vn-chapter-title").innerHTML = L({ en: scene.dataset.titleEn || "", ja: scene.dataset.titleJa || "" });
    S.mode = "chapter";
    box.classList.add("is-hidden");
    chapter.classList.add("is-shown");
    S.chapterTimer = setTimeout(endChapter, reduceMotion ? 1200 : 2100);
  }

  function endChapter() {
    if (S.mode !== "chapter") { return; }
    clearTimeout(S.chapterTimer);
    chapter.classList.remove("is-shown");
    box.classList.remove("is-hidden");
    S.mode = "lines";
    nextLine();
  }

  function nextLine() {
    S.i += 1;
    if (S.i >= S.lines.length) { finishScene(); return; }
    var line = S.lines[S.i];
    if (line.event) {
      if (line.stage) { setCast(line.stage); }
      setSpeaker(null);
      if (DEMOS[line.event]) { openDemo(DEMOS[line.event]); return; }
      if (line.event === "reviews") { openReviews(S.scene.querySelector(".vn-reviews")); return; }
    }
    var text = { en: line.text.en.replace("@TAPS@", S.demoTaps), ja: line.text.ja.replace("@TAPS@", S.demoTaps) };
    if (line.stage) {
      setCast(line.stage);
    } else if (CAST[line.who] && line.who !== "you" && S.cast.indexOf(line.who) < 0) {
      setCast(S.cast.concat(line.who));
    }
    var info = CAST[line.who] || SPECIAL[line.who] || null;
    var onStage = S.cast.indexOf(line.who) >= 0;
    box.dataset.kind = CAST[line.who] ? "character" : SPECIAL[line.who] ? line.who : "narration";
    box.style.setProperty("--accent", info ? info.color : "#94a3b8");
    box.querySelector(".vn-name").innerHTML = info ? L(info.name) : "";
    box.querySelector(".vn-role").innerHTML = info && info.role ? L(info.role) : "";
    box.querySelector(".vn-plate-icon").innerHTML = info && info.icon ? svg(info.icon) : "";
    box.classList.toggle("has-face", line.who === "you" && !onStage);
    box.classList.remove("is-ready", "is-pop");
    void box.offsetWidth;
    box.classList.add("is-pop");
    setSpeaker(onStage ? line.who : null);
    S.log.push({ name: info ? info.name : null, color: info ? info.color : "", text: text });
    srEl.textContent = text[lang];
    typeText(text, onStage ? spriteOf(line.who) : null);
  }

  function typeText(pair, sprite) {
    S.full = pair;
    S.typing = true;
    S.talker = sprite;
    if (sprite) { sprite.classList.add("is-talking"); }
    if (reduceMotion) { finishTyping(); return; }
    var n = 0;
    (function tick() {
      var text = S.full[lang];
      n += 1;
      textEl.textContent = text.slice(0, n);
      if (n >= text.length) { finishTyping(); return; }
      var pause = "、。！？…」）.,!?".indexOf(text.charAt(n - 1)) >= 0;
      S.timer = setTimeout(tick, pause ? 150 : lang === "en" ? 16 : 32);
    })();
  }

  function finishTyping() {
    clearTimeout(S.timer);
    textEl.textContent = S.full[lang];
    S.typing = false;
    if (S.talker) { S.talker.classList.remove("is-talking"); }
    box.classList.add("is-ready");
  }

  // ---- 解約画面の体験 ----
  var demo = { el: null, screen: null, toast: null, toastTimer: 0, step: 0, taps: 0, start: 0, reason: -1, actions: [] };

  function openDemo(def) {
    demo.def = def;
    S.mode = "demo";
    box.classList.add("is-hidden");
    demo.taps = 0;
    demo.reason = -1;
    demo.start = Date.now();
    demo.el = el("div", "vn-demo",
      '<div class="vn-demo-head"><span class="vn-demo-tag">' + L(def.tag) + "</span><p>" + L(def.task) + '</p><span class="vn-demo-taps"></span></div>' +
      '<div class="vn-phone"><div class="vn-phone-bar"><b>LearnLoop</b><span>9:41</span></div><div class="vn-phone-screen"></div>' +
      '<div class="vn-phone-toast" aria-live="polite"></div></div>');
    demo.screen = demo.el.querySelector(".vn-phone-screen");
    demo.toast = demo.el.querySelector(".vn-phone-toast");
    demo.el.addEventListener("click", onDemoClick);
    body.appendChild(demo.el);
    renderDemo(0);
    requestAnimationFrame(function () { demo.el.classList.add("is-open"); });
  }

  function updateTaps() {
    demo.el.querySelector(".vn-demo-taps").innerHTML = L({ en: "Taps: " + demo.taps, ja: "タップ数：" + demo.taps });
  }

  function renderDemo(i) {
    var s = demo.def.screens[i];
    demo.step = i;
    demo.actions = [];
    function act(a) { demo.actions.push(a); return demo.actions.length - 1; }
    var html = '<h3 class="vn-app-title">' + L(s.title) + "</h3>";
    if (s.items) {
      html += '<ul class="vn-app-list">' + s.items.map(function (it) {
        return '<li><button type="button" data-act="' + act(it) + '">' + L(it.label) + "<span>›</span></button></li>";
      }).join("") + "</ul>";
    }
    if (s.card) { html += '<div class="vn-app-card">' + L(s.card) + "</div>"; }
    if (s.heading) { html += '<p class="vn-app-heading">' + L(s.heading) + "</p>"; }
    if (s.text) { html += '<p class="vn-app-text">' + L(s.text) + "</p>"; }
    if (s.reasons) {
      html += '<div class="vn-app-reasons">' + s.reasons.map(function (r, n) {
        return '<button type="button" class="vn-app-reason' + (demo.reason === n ? " is-on" : "") + '" data-act="' + act({ reason: n }) + '">' + L(r) + "</button>";
      }).join("") + "</div>";
    }
    if (s.primary) { html += '<button type="button" class="vn-app-primary" data-act="' + act(s.primary) + '">' + L(s.primary.label) + "</button>"; }
    if (s.link) { html += '<button type="button" class="vn-app-link" data-act="' + act(s.link) + '">' + L(s.link.label) + "</button>"; }
    demo.screen.innerHTML = html;
    updateTaps();
    var first = demo.screen.querySelector("button");
    if (first) { first.focus({ preventScroll: true }); }
  }

  function demoToast(pair) {
    demo.toast.innerHTML = L(pair);
    demo.toast.classList.add("is-shown");
    clearTimeout(demo.toastTimer);
    demo.toastTimer = setTimeout(function () { demo.toast.classList.remove("is-shown"); }, 2200);
  }

  function onDemoClick(e) {
    if (e.target.closest(".vn-demo-close")) { closeDemo(); return; }
    var b = e.target.closest("[data-act]");
    if (!b) { return; }
    demo.taps += 1;
    var a = demo.actions[Number(b.dataset.act)];
    if (a.reason != null) { demo.reason = a.reason; renderDemo(demo.step); return; }
    if (a.needsReason && demo.reason < 0) { demoToast(UI.pickReason); updateTaps(); return; }
    if (a.toast) { demoToast(a.toast); updateTaps(); return; }
    if (a.done) { showDemoSummary(); return; }
    if (a.go != null) { renderDemo(a.go); }
  }

  function showDemoSummary() {
    var secs = Math.max(1, Math.round((Date.now() - demo.start) / 1000));
    S.demoTaps = demo.taps;
    demo.toast.classList.remove("is-shown");
    updateTaps();
    demo.screen.innerHTML = '<div class="vn-demo-result"><p class="vn-demo-big">' + demo.taps + '</p><p class="vn-demo-unit">' + L(UI.tapsUnit) + "</p>" +
      "<p>" + L({ en: "Time: " + secs + " s", ja: "かかった時間：" + secs + " 秒" }) + "</p>" +
      '<p class="vn-demo-q">' + L(demo.def.question) + "</p>" +
      '<button type="button" class="vn-app-primary vn-demo-close">' + L(UI.demoClose) + "</button></div>";
    demo.screen.querySelector(".vn-demo-close").focus({ preventScroll: true });
    S.log.push({ note: true, text: { en: demo.def.log.en + ": " + demo.taps + " taps", ja: demo.def.log.ja + "：" + demo.taps + " 回タップ" } });
  }

  function closeDemo() {
    var node = demo.el;
    node.classList.remove("is-open");
    setTimeout(function () { node.remove(); }, 350);
    S.mode = "lines";
    box.classList.remove("is-hidden");
    nextLine();
  }

  // ---- 後日談：ストアのレビューを読む（操作なし） ----
  function stars(n) {
    return '<span class="vn-stars" aria-label="' + n + ' / 5">' + "★".repeat(n) + "<i>" + "★".repeat(5 - n) + "</i></span>";
  }

  function openReviews(wrap) {
    S.mode = "demo";
    box.classList.add("is-hidden");
    var rating = Number(wrap.dataset.rating) || 0;
    var trend = wrap.dataset.trend === "up" ? UI.trendUp : wrap.dataset.trend === "down" ? UI.trendDown : null;
    var reviews = Array.prototype.map.call(wrap.querySelectorAll(".vn-review"), function (r) {
      return { name: r.dataset.name, stars: Number(r.dataset.stars) || 0, text: textPair(r) };
    });
    var cards = reviews.map(function (r, n) {
      return '<div class="vn-review-card" style="--i:' + n + '"><div class="vn-review-top"><b>' + esc(r.name) + "</b>" + stars(r.stars) + "</div><p>" + L(r.text) + "</p></div>";
    }).join("");
    var node = el("div", "vn-demo vn-store",
      '<div class="vn-demo-head"><span class="vn-demo-tag">' + L(UI.storeTag) + "</span><p>" + L(UI.storeTask) + "</p></div>" +
      '<div class="vn-phone"><div class="vn-phone-bar"><b>App Store</b><span>9:41</span></div><div class="vn-phone-screen">' +
      '<div class="vn-store-app"><span class="vn-store-icon">L</span><span class="vn-store-name"><b>LearnLoop</b><small>' + L(UI.storeSub) + "</small></span></div>" +
      '<div class="vn-store-score"><strong>' + rating.toFixed(1) + "</strong>" + stars(Math.round(rating)) +
      (trend ? '<span class="vn-store-trend ' + (wrap.dataset.trend === "up" ? "is-up" : "is-down") + '">' + L(trend) + "</span>" : "") + "</div>" +
      '<p class="vn-store-h">' + L(UI.storeHeading) + "</p>" + cards + "</div></div>" +
      '<button type="button" class="vn-app-primary vn-demo-close" style="--n:' + reviews.length + '">' + L(UI.storeClose) + "</button>");
    body.appendChild(node);
    requestAnimationFrame(function () { node.classList.add("is-open"); });
    // レビューが1件ずつ現れるのに合わせて、画面を下までスクロールする
    var screen = node.querySelector(".vn-phone-screen");
    reviews.forEach(function (r, n) {
      setTimeout(function () { screen.scrollTo({ top: screen.scrollHeight, behavior: reduceMotion ? "auto" : "smooth" }); }, n * 900 + 700);
    });
    reviews.forEach(function (r) {
      S.log.push({ name: { en: r.name + " " + "★".repeat(r.stars), ja: r.name + " " + "★".repeat(r.stars) }, color: "#b7791f", text: r.text });
    });
    node.querySelector(".vn-demo-close").addEventListener("click", function () {
      node.classList.remove("is-open");
      setTimeout(function () { node.remove(); }, 350);
      S.mode = "lines";
      box.classList.remove("is-hidden");
      nextLine();
    });
  }

  function finishScene() {
    if (S.choices) {
      S.mode = "choice";
      stage.classList.add("is-dim");
      box.classList.remove("is-ready");
      S.choices.classList.add("is-open");
      S.choiceOpenedAt = Date.now();
      var first = S.choices.querySelector(".vn-choice");
      if (first) { first.focus({ preventScroll: true }); }
    } else if (S.ending) {
      S.mode = "ending";
      stage.classList.add("is-dim");
      box.classList.add("is-hidden");
      fillEnding(S.ending);
      S.ending.classList.add("is-open");
      var again = S.ending.querySelector(".vn-btn");
      if (again) { again.focus({ preventScroll: true }); }
    } else if (S.scene.querySelector(".vn-continue tw-link")) {
      // 後日談など、次の場面へそのまま進む
      S.mode = "leaving";
      box.classList.add("is-hidden");
      var next = S.scene.querySelector(".vn-continue tw-link");
      setTimeout(function () { next.click(); }, reduceMotion ? 0 : 300);
    } else {
      S.mode = "done";
    }
  }

  function choose(card) {
    // 会話を連打していたクリックが、出てきたばかりの選択肢に当たらないようにする
    if (S.mode !== "choice" || Date.now() - S.choiceOpenedAt < 450) { return; }
    S.mode = "leaving";
    card.classList.add("is-chosen");
    var title = card.querySelector(".vn-choice-title");
    S.log.push({ choice: true, text: title ? textPair(title) : { en: "", ja: "" } });
    var link = card.querySelector("tw-link");
    setTimeout(function () { if (link) { link.click(); } }, reduceMotion ? 0 : 280);
  }

  function advance() {
    if (!logPanel.hidden) { return; }
    if (S.mode === "chapter") { endChapter(); return; }
    if (S.mode !== "lines") { return; }
    if (S.typing) { finishTyping(); } else { nextLine(); }
  }

  // ---- 会話ログ ----
  function openLog() {
    logPanel.querySelector(".vn-log-list").innerHTML = S.log.map(function (item) {
      if (item.note) { return '<li class="is-choice">▶ ' + L(item.text) + "</li>"; }
      if (item.choice) {
        return '<li class="is-choice">▶ ' + L({ en: UI.yourChoice.en + item.text.en, ja: UI.yourChoice.ja + item.text.ja }) + "</li>";
      }
      return "<li>" + (item.name ? '<b style="color:' + item.color + '">' + L(item.name) + "</b>" : "") + "<p>" + L(item.text) + "</p></li>";
    }).join("") || '<li class="is-empty">' + L(UI.empty) + "</li>";
    logPanel.hidden = false;
    var list = logPanel.querySelector(".vn-log-list");
    list.scrollTop = list.scrollHeight;
    logPanel.querySelector(".vn-log-close").focus();
  }
  function closeLog() { logPanel.hidden = true; }

  ui.querySelector(".vn-log-btn").addEventListener("click", function (e) { e.stopPropagation(); openLog(); });
  logPanel.addEventListener("click", function (e) {
    if (e.target === logPanel || e.target.closest(".vn-log-close")) { closeLog(); }
  });

  document.addEventListener("click", function (e) {
    var t = e.target;
    if (!t.closest) { return; }
    var btn = t.closest(".vn-btn");
    if (btn) {
      // ボタンの中にある Harlowe のリンクを代わりに押す（リンク自体のクリックは Harlowe に任せる）
      var link = btn.querySelector("tw-link");
      if (link && !t.closest("tw-link")) { link.click(); }
      return;
    }
    if (t.closest("a, button, tw-link, .vn-choice, .vn-ending-card, .vn-title, .vn-log, .vn-lang, .vn-demo")) { return; }
    advance();
  });

  document.addEventListener("keydown", function (e) {
    if (e.altKey || e.ctrlKey || e.metaKey) { return; }
    var key = e.key;
    var active = document.activeElement;
    if (!logPanel.hidden) {
      if (key === "Escape" || key === "l" || key === "L") { closeLog(); e.preventDefault(); }
      return;
    }
    if (S.mode === "choice") {
      var cards = Array.prototype.slice.call(S.choices.querySelectorAll(".vn-choice"));
      var at = cards.indexOf(active);
      if (/^[1-9]$/.test(key) && cards[Number(key) - 1]) { choose(cards[Number(key) - 1]); e.preventDefault(); }
      else if ((key === "Enter" || key === " ") && at >= 0) { choose(active); e.preventDefault(); }
      else if (key === "ArrowDown" || key === "ArrowUp") {
        var to = cards[(at + (key === "ArrowDown" ? 1 : cards.length - 1)) % cards.length] || cards[0];
        to.focus();
        e.preventDefault();
      }
      return;
    }
    if ((key === "Enter" || key === " ") && active && active.classList && active.classList.contains("vn-btn")) {
      active.click();
      e.preventDefault();
      return;
    }
    if ((key === "l" || key === "L") && S.mode !== "title") { openLog(); return; }
    if (key === " " || key === "Enter" || key === "ArrowRight") {
      if (S.mode === "chapter" || S.mode === "lines") { advance(); e.preventDefault(); }
    }
  });

  // ---- Harlowe のパッセージ切り替えを監視 ----
  var story = document.querySelector("tw-story");
  function scan() {
    var passages = story.querySelectorAll("tw-passage");
    for (var n = passages.length - 1; n >= 0; n--) {
      if (!passages[n].vnSeen) {
        passages[n].vnSeen = true;
        S.passage = passages[n];
        setupPassage(passages[n]);
        return;
      }
    }
  }
  new MutationObserver(function () { requestAnimationFrame(scan); }).observe(story, { childList: true });
  requestAnimationFrame(scan);
})();

:: StoryStylesheet [stylesheet]
@import url("https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap");

:root {
  --ink: #1e293b;
  --muted: #64748b;
  --blue: #2f63d6;
  --paper: #f8fafc;
  --font: "Zen Maru Gothic", "Hiragino Maru Gothic ProN", "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif;
  --box-h: clamp(150px, 25vh, 215px);
}

html, body { background: #0f172a; height: 100%; margin: 0; overflow: hidden; }
body { color: var(--ink); font-family: var(--font); }

/* Harlowe 標準レイアウトを打ち消し、全画面の舞台にする */
tw-story {
  background: transparent; box-sizing: border-box; color: var(--ink); display: block; font-family: var(--font); font-size: 16px;
  height: 100%; inset: 0; line-height: 1.6; margin: 0; max-width: none; padding: 0; pointer-events: none;
  position: fixed; width: 100%; z-index: 3;
}
tw-passage { inset: 0; pointer-events: none; position: absolute; }
tw-sidebar { display: none !important; }
tw-passage br { display: none; }
.vn-line, .vn-hud-data { display: none !important; }
a { color: var(--blue); }

/* 言語切り替え：選択中でない言語のテキストを隠す */
html[data-lang="en"] [lang="ja"], html[data-lang="ja"] [lang="en"] { display: none !important; }
.vn-lang {
  backdrop-filter: blur(6px); background: rgba(15, 23, 42, .74); border: 1px solid rgba(255, 255, 255, .12); border-radius: 12px;
  display: flex; gap: 2px; padding: 3px; position: fixed; right: 16px; top: 14px; z-index: 6;
}
.vn-lang button {
  background: transparent; border: 0; border-radius: 9px; color: #cbd5e1; cursor: pointer; font: 700 .76rem var(--font);
  letter-spacing: .04em; padding: 6px 11px;
}
.vn-lang button[aria-pressed="true"] { background: #fff; color: var(--blue); }
.vn-lang button:focus-visible { outline: 2px solid #9dbcff; }

/* ---------- 背景と立ち絵 ---------- */
.vn-stage { inset: 0; overflow: hidden; position: fixed; z-index: 0; }
.vn-bg {
  background-position: center; background-size: cover; filter: blur(2.5px) saturate(1.05); inset: -24px;
  opacity: 0; position: absolute; transform: scale(1.02); transition: opacity 1s ease, transform 14s ease-out;
}
.vn-bg.is-active { opacity: 1; transform: scale(1.07); }
.vn-bg[data-bg="office"] { background-image: url("assets/bg/office.svg"); }
.vn-bg[data-bg="meeting"] { background-image: url("assets/bg/meeting.svg"); }
.vn-bg[data-bg="night"] { background-image: url("assets/bg/night.svg"); }
.vn-bg[data-bg="evening"] { background-image: url("assets/bg/evening.svg"); }
.vn-shade {
  background: linear-gradient(to bottom, rgba(15, 23, 42, .28), transparent 20%, transparent 58%, rgba(15, 23, 42, .42));
  inset: 0; position: absolute; transition: background-color .4s;
}
.vn-stage.is-dim .vn-shade { background-color: rgba(15, 23, 42, .38); }

.vn-cast { inset: 0; position: absolute; }
.vn-sprite {
  bottom: 0; height: 100%; left: 50%; position: absolute; top: 0; width: 0;
  transition: left .65s cubic-bezier(.2, .8, .2, 1), opacity .5s ease var(--delay, 0s), transform .55s cubic-bezier(.2, .8, .2, 1) var(--delay, 0s), filter .35s ease;
}
.vn-sprite.is-leaving { opacity: 0; transform: translateY(36px); }
.vn-sprite[data-pos="center"] { left: 50%; }
.vn-sprite[data-pos="left"] { left: 29%; }
.vn-sprite[data-pos="right"] { left: 71%; }
.vn-sprite[data-pos="l3"] { left: 20%; }
.vn-sprite[data-pos="c3"] { left: 50%; }
.vn-sprite[data-pos="r3"] { left: 80%; }
.vn-sprite[data-pos="t1"] { left: 62%; }
.vn-sprite[data-pos="t2"] { left: 77%; }
.vn-sprite[data-pos="t3"] { left: 91%; }
.vn-sprite-motion { aspect-ratio: 2 / 3; height: 168vh; left: 0; position: absolute; top: 4vh; translate: -50% 0; }
.vn-sprite img {
  animation: vn-breathe 4.6s ease-in-out infinite; display: block; filter: drop-shadow(0 14px 32px rgba(15, 23, 42, .3));
  height: 100%; transform-origin: 50% 100%; width: 100%;
}
.vn-cast.has-speaker .vn-sprite:not(.is-speaking) { filter: brightness(.6) saturate(.75); }
.vn-sprite.is-speaking { z-index: 2; }
.vn-sprite.is-talking .vn-sprite-motion { animation: vn-talk .34s ease-in-out infinite alternate; }
.vn-cast.is-title .vn-sprite-motion { height: 140vh; top: 9vh; }

/* ---------- HUD ---------- */
.vn-ui { inset: 0; pointer-events: none; position: fixed; z-index: 2; }
.vn-hud {
  align-items: flex-start; display: flex; gap: 12px; justify-content: space-between; left: 16px; position: absolute;
  right: 150px; top: 14px; transition: opacity .4s;
}
.vn-on-title .vn-hud, .vn-on-title .vn-box { opacity: 0; visibility: hidden; }
.vn-scene-tag {
  align-items: center; background: rgba(255, 255, 255, .86); border-radius: 999px; box-shadow: 0 6px 20px rgba(15, 23, 42, .18);
  color: var(--ink); display: flex; font-size: .74rem; font-weight: 700; gap: 10px; letter-spacing: .1em; padding: 5px 14px 5px 5px;
}
.vn-day { background: var(--blue); border-radius: 999px; color: #fff; padding: 3px 11px; }
.vn-hud-right { align-items: flex-start; display: flex; gap: 8px; }
.vn-meters {
  backdrop-filter: blur(6px); background: rgba(15, 23, 42, .74); border: 1px solid rgba(255, 255, 255, .12);
  border-radius: 14px; display: flex; gap: 14px; padding: 8px 12px;
}
.vn-meter { color: #e2e8f0; font-size: .7rem; position: relative; width: 132px; }
.vn-meter-top { align-items: center; display: flex; gap: 5px; }
.vn-meter-icon { color: var(--c); display: inline-flex; height: 15px; width: 15px; }
.vn-meter-icon svg { height: 100%; width: 100%; }
.vn-meter-label { flex: 1; white-space: nowrap; }
.vn-meter-value { color: #fff; font-size: .92rem; font-variant-numeric: tabular-nums; }
.vn-meter-bar { background: rgba(255, 255, 255, .16); border-radius: 99px; height: 6px; margin-top: 5px; overflow: hidden; }
.vn-meter-bar i { background: var(--c); border-radius: inherit; display: block; height: 100%; transition: width 1s cubic-bezier(.2, .8, .2, 1) .3s; width: 0; }
.vn-delta {
  border-radius: 99px; color: #fff; font-size: .78rem; font-style: normal; font-weight: 900; opacity: 0; padding: 1px 8px;
  pointer-events: none; position: absolute; right: -6px; top: 30px;
}
.vn-delta.is-up { background: #23a866; }
.vn-delta.is-down { background: #d9534f; }
.vn-delta.is-shown { animation: vn-delta 3.4s ease .5s both; }
.vn-log-btn {
  align-items: center; backdrop-filter: blur(6px); background: rgba(15, 23, 42, .74); border: 1px solid rgba(255, 255, 255, .12);
  border-radius: 12px; color: #e2e8f0; cursor: pointer; display: flex; font: 700 .76rem var(--font); gap: 6px; padding: 9px 12px; pointer-events: auto;
}
.vn-log-btn svg { height: 16px; width: 16px; }
.vn-log-btn:hover, .vn-log-btn:focus-visible { background: rgba(15, 23, 42, .92); outline: 2px solid #9dbcff; }

/* ---------- 章タイトル ---------- */
.vn-chapter { display: grid; inset: 0; opacity: 0; place-items: center; position: absolute; transition: opacity .5s ease; }
.vn-chapter.is-shown { opacity: 1; }
.vn-chapter-inner {
  background: linear-gradient(90deg, transparent, rgba(15, 23, 42, .8) 18%, rgba(15, 23, 42, .8) 82%, transparent);
  color: #fff; padding: 22px 16px 26px; text-align: center; width: 100%;
}
.vn-chapter-day { color: #a8c4ff; font-size: .8rem; font-weight: 700; letter-spacing: .3em; margin: 0 0 6px; }
.vn-chapter-title { font-size: clamp(1.35rem, 3.4vw, 2.3rem); font-weight: 900; letter-spacing: .06em; margin: 0; }
.vn-chapter.is-shown .vn-chapter-title { animation: vn-rise .7s cubic-bezier(.2, .8, .2, 1) both; }

/* ---------- 会話ウィンドウ ---------- */
.vn-box {
  --accent: #94a3b8;
  backdrop-filter: blur(10px); background: linear-gradient(180deg, rgba(255, 255, 255, .95), rgba(243, 246, 250, .92));
  border: 2px solid rgba(255, 255, 255, .95); border-radius: 22px; bottom: max(16px, 3vh); box-sizing: border-box;
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 38%, transparent), 0 22px 50px rgba(15, 23, 42, .38);
  left: 50%; min-height: var(--box-h); padding: 34px 44px 30px; position: absolute; transform: translateX(-50%);
  transition: opacity .35s ease, transform .35s ease, box-shadow .3s ease; width: min(1080px, calc(100% - 32px));
}
.vn-box.is-hidden { opacity: 0; transform: translate(-50%, 16px); }
.vn-box.is-pop { animation: vn-pop .28s ease-out; }
.vn-plate {
  align-items: center; background: var(--accent); border-radius: 999px; box-shadow: 0 6px 16px rgba(15, 23, 42, .25);
  color: #fff; display: flex; font-size: 1.04rem; font-weight: 700; gap: 7px; left: 26px; letter-spacing: .06em;
  padding: 6px 20px 6px 18px; position: absolute; top: -21px; transition: background .3s;
}
.vn-plate small { font-size: .7rem; font-weight: 500; letter-spacing: .02em; opacity: .9; }
.vn-plate-icon { display: inline-flex; }
.vn-plate-icon:empty { display: none; }
.vn-plate-icon svg { height: 17px; width: 17px; }
.vn-box[data-kind="narration"] .vn-plate { display: none; }
.vn-box[data-kind="narration"] .vn-text { color: #334155; }
.vn-box[data-kind="reflect"] { background: linear-gradient(180deg, rgba(241, 246, 255, .97), rgba(229, 238, 252, .94)); }
.vn-box[data-kind="notice"] .vn-text { color: #334155; font-weight: 700; }
.vn-box[data-kind="jordan"] { background: linear-gradient(180deg, rgba(248, 250, 252, .97), rgba(234, 240, 249, .95)); }
.vn-box[data-kind="jordan"] .vn-text { color: #334155; }

/* ---------- 解約画面の体験（Jordan の視点） ---------- */
.vn-demo {
  align-items: center; backdrop-filter: blur(4px); background: rgba(15, 23, 42, .62); box-sizing: border-box; display: flex;
  flex-direction: column; gap: 12px; inset: 0; justify-content: center; opacity: 0; padding: 64px 16px 16px; position: fixed;
  transition: opacity .35s ease; z-index: 5;
}
.vn-demo.is-open { opacity: 1; }
.vn-demo-head { color: #fff; text-align: center; }
.vn-demo-tag { background: #fff; border-radius: 999px; color: var(--blue); display: inline-block; font-size: .72rem; font-weight: 700; letter-spacing: .14em; padding: 3px 12px; }
.vn-demo-head p { font-size: 1.05rem; font-weight: 700; margin: 8px 0 2px; }
.vn-demo-taps { color: #cbd5e1; font-size: .8rem; font-variant-numeric: tabular-nums; }
.vn-phone {
  background: #f8fafc; border: 10px solid #111827; border-radius: 34px; box-shadow: 0 30px 70px rgba(0, 0, 0, .45); box-sizing: border-box;
  display: flex; flex-direction: column; height: min(560px, calc(100vh - 160px)); overflow: hidden; position: relative; width: min(340px, 100%);
}
.vn-phone-bar { align-items: center; background: var(--blue); color: #fff; display: flex; font-size: .82rem; justify-content: space-between; padding: 10px 16px; }
.vn-phone-screen { display: flex; flex: 1; flex-direction: column; gap: 10px; overflow: auto; padding: 16px; }
.vn-app-title { color: var(--ink); font-size: 1.1rem; margin: 0 0 2px; }
.vn-app-list { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; list-style: none; margin: 0; overflow: hidden; padding: 0; }
.vn-app-list li + li { border-top: 1px solid #e2e8f0; }
.vn-app-list button {
  align-items: center; background: none; border: 0; color: var(--ink); cursor: pointer; display: flex; font: 500 .92rem var(--font);
  justify-content: space-between; padding: 13px 14px; text-align: left; width: 100%;
}
.vn-app-list button:hover, .vn-app-list button:focus-visible { background: #f1f5f9; outline: none; }
.vn-app-list button span[lang] { color: var(--ink); }
.vn-app-heading { color: var(--ink); font-size: 1.15rem; font-weight: 900; line-height: 1.4; margin: 6px 0 0; }
.vn-app-text { color: var(--muted); font-size: .88rem; margin: 0; }
.vn-app-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; color: var(--ink); font-size: .84rem; padding: 12px 14px; }
.vn-app-reasons { display: grid; gap: 8px; }
.vn-app-reason {
  background: #fff; border: 1.5px solid #e2e8f0; border-radius: 12px; color: var(--ink); cursor: pointer; font: 500 .88rem var(--font);
  padding: 10px 12px; text-align: left;
}
.vn-app-reason.is-on { background: #eef4ff; border-color: var(--blue); }
.vn-app-primary {
  background: linear-gradient(120deg, #f59e0b, #ea580c); border: 0; border-radius: 14px; box-shadow: 0 8px 18px rgba(234, 88, 12, .32);
  color: #fff; cursor: pointer; font: 900 1rem var(--font); margin-top: auto; padding: 15px 12px;
}
.vn-app-primary:focus-visible, .vn-app-reason:focus-visible { outline: 3px solid #93b4ff; }
.vn-app-link { background: none; border: 0; color: #a3adbb; cursor: pointer; font: 500 .68rem var(--font); padding: 4px; text-decoration: underline; }
.vn-phone-toast {
  background: rgba(15, 23, 42, .92); border-radius: 12px; color: #fff; font-size: .8rem; left: 14px; opacity: 0; padding: 9px 12px;
  pointer-events: none; position: absolute; right: 14px; top: 52px; transform: translateY(-8px); transition: opacity .2s, transform .2s;
}
.vn-phone-toast.is-shown { opacity: 1; transform: none; }
.vn-demo-result { display: flex; flex-direction: column; gap: 4px; margin: auto 0; text-align: center; }
.vn-demo-result p { color: var(--ink); margin: 0; }
.vn-demo-big { color: var(--blue) !important; font-size: 3.4rem; font-weight: 900; line-height: 1; }
.vn-demo-unit { color: var(--muted) !important; }
.vn-demo-q { font-weight: 700; line-height: 1.6; margin: 12px 0 !important; }
/* ---------- 後日談：ストアのレビュー ---------- */
.vn-reviews, .vn-continue { display: none !important; }
.vn-store-app { align-items: center; display: flex; gap: 12px; }
.vn-store-icon {
  align-items: center; background: linear-gradient(135deg, #2f63d6, #6b93f0); border-radius: 14px; color: #fff; display: flex; flex: none;
  font-size: 1.5rem; font-weight: 900; height: 54px; justify-content: center; width: 54px;
}
.vn-store-name b { color: var(--ink); display: block; font-size: 1rem; }
.vn-store-name small { color: var(--muted); font-size: .72rem; }
.vn-store-score { align-items: center; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; display: flex; flex-wrap: wrap; gap: 10px; padding: 10px 14px; }
.vn-store-score strong { color: var(--ink); font-size: 2.1rem; line-height: 1; }
.vn-stars { color: #f59e0b; font-size: .9rem; letter-spacing: .06em; white-space: nowrap; }
.vn-stars i { color: #d5dbe4; font-style: normal; }
.vn-store-trend { border-radius: 99px; font-size: .68rem; font-weight: 700; margin-left: auto; padding: 2px 8px; }
.vn-store-trend.is-up { background: #dcfce7; color: #15803d; }
.vn-store-trend.is-down { background: #fee2e2; color: #b91c1c; }
.vn-store-h { color: var(--ink); font-size: .86rem; font-weight: 700; margin: 4px 0 0; }
.vn-review-card {
  animation: vn-rise .55s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * .9s + .5s);
  background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; flex: none; padding: 10px 12px;
}
.vn-review-top { align-items: center; display: flex; font-size: .8rem; justify-content: space-between; }
.vn-review-top b { color: var(--ink); }
.vn-review-card p { color: var(--ink); font-size: .84rem; line-height: 1.6; margin: 4px 0 0; }
.vn-store .vn-phone { height: min(540px, calc(100vh - 230px)); }
.vn-store .vn-demo-close {
  animation: vn-rise .5s both; animation-delay: calc(var(--n) * .9s + .7s); background: linear-gradient(120deg, #2f63d6, #1e4fb5);
  box-shadow: 0 8px 18px rgba(47, 99, 214, .35); flex: none; margin-top: 0; padding: 13px 34px;
}

/* ---------- エンディング：守れたもの／失ったもの ---------- */
.vn-ending-ledger { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; margin-top: 14px; text-align: left; }
.vn-ending-ledger > div { border-radius: 12px; font-size: .84rem; padding: 10px 14px; }
.vn-ending-ledger h3 { font-size: .76rem; letter-spacing: .06em; margin: 0 0 2px; }
.vn-ending-ledger p { line-height: 1.65 !important; margin: 0 !important; }
.vn-kept { background: #ecfdf5; }
.vn-kept h3 { color: #047857; }
.vn-lost { background: #fef2f2; }
.vn-lost h3 { color: #b91c1c; }

.vn-demo-result .vn-demo-close { background: linear-gradient(120deg, #2f63d6, #1e4fb5); box-shadow: 0 8px 18px rgba(47, 99, 214, .35); }
.vn-text { font-size: clamp(1rem, 1.55vw, 1.2rem); letter-spacing: .03em; line-height: 1.9; margin: 0; min-height: 3.8em; }
.vn-sr { clip: rect(0 0 0 0); height: 1px; margin: -1px; overflow: hidden; position: absolute; width: 1px; }
.vn-face {
  background: url("assets/m2.png") 51% 4% / 470% auto no-repeat, linear-gradient(160deg, #e3e9f8, #c9d4ee);
  border: 3px solid #fff; border-radius: 18px; bottom: 24px; box-shadow: 0 6px 18px rgba(15, 23, 42, .25);
  display: none; height: 108px; left: 26px; position: absolute; width: 108px;
}
.vn-box.has-face { padding-left: 156px; }
.vn-box.has-face .vn-face { display: block; }
.vn-box.has-face .vn-plate { left: 150px; }
.vn-next {
  align-items: center; bottom: 12px; color: var(--accent); display: flex; font-size: .7rem; font-weight: 700; gap: 6px;
  opacity: 0; position: absolute; right: 24px; transition: opacity .2s;
}
.vn-next span { color: var(--muted); letter-spacing: .08em; }
.vn-next b { animation: vn-bounce 1s ease-in-out infinite; font-size: .9rem; }
.vn-box.is-ready .vn-next { opacity: 1; }

/* ---------- 選択肢 ---------- */
.vn-choices {
  align-items: center; box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; inset: 0; justify-content: center;
  opacity: 0; padding: 74px 16px calc(var(--box-h) + 44px); pointer-events: none; position: fixed; transition: opacity .35s ease, visibility .35s;
  visibility: hidden;
}
.vn-choices.is-open { opacity: 1; visibility: visible; }
.vn-choices.is-open .vn-choice { pointer-events: auto; }
.vn-choice-prompt > span {
  background: rgba(15, 23, 42, .8); border-radius: 999px; color: #fff; display: inline-block; font-size: .86rem; font-weight: 700;
  letter-spacing: .12em; padding: 6px 20px;
}
.vn-choice-prompt > span::before { color: #93b4ff; content: "◆ "; }
.vn-choice {
  align-items: center; background: rgba(255, 255, 255, .95); border: 2px solid transparent; border-radius: 18px;
  box-shadow: 0 10px 28px rgba(15, 23, 42, .3); box-sizing: border-box; cursor: pointer; display: grid; gap: 14px;
  grid-template-columns: auto auto minmax(0, 1fr) auto; overflow: hidden; padding: 12px 18px 12px 16px; position: relative;
  transition: transform .22s ease, box-shadow .22s ease, border-color .2s ease, background .2s ease; width: min(780px, 100%);
}
.vn-choice::before { background: var(--c); bottom: 0; content: ""; left: 0; position: absolute; top: 0; width: 6px; }
.vn-choices.is-open .vn-choice { animation: vn-choice-in .5s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * 90ms + 80ms); }
.vn-choice:hover, .vn-choice:focus-visible {
  background: #fff; border-color: var(--c); box-shadow: 0 14px 34px color-mix(in srgb, var(--c) 45%, transparent);
  outline: none; transform: translateX(6px) scale(1.01);
}
.vn-choice.is-chosen { background: color-mix(in srgb, var(--c) 14%, #fff); border-color: var(--c); transform: scale(1.03); }
.vn-choices:has(.is-chosen) .vn-choice:not(.is-chosen) { opacity: .35; transform: scale(.97); }
.vn-choice-key {
  align-items: center; background: #eef2f7; border-radius: 9px; color: var(--muted); display: flex; font-size: .82rem;
  font-weight: 700; height: 28px; justify-content: center; width: 28px;
}
.vn-choice-icon {
  align-items: center; background: var(--c); border-radius: 50%; box-shadow: 0 6px 14px color-mix(in srgb, var(--c) 45%, transparent);
  color: #fff; display: flex; height: 46px; justify-content: center; width: 46px;
}
.vn-choice-icon svg { height: 25px; width: 25px; }
.vn-choice-body { display: flex; flex-direction: column; min-width: 0; }
.vn-choice-tag {
  align-self: flex-start; background: color-mix(in srgb, var(--c) 13%, #fff); border-radius: 99px; color: var(--c);
  font-size: .7rem; font-weight: 700; letter-spacing: .06em; margin-bottom: 3px; padding: 1px 10px;
}
.vn-choice tw-link, .vn-choice tw-hook, .vn-choice tw-expression, .vn-btn tw-link, .vn-btn tw-hook, .vn-btn tw-expression { display: none; }
.vn-choice-title {
  color: var(--ink); font-size: clamp(.98rem, 1.45vw, 1.12rem); font-weight: 700; line-height: 1.45; pointer-events: none; text-decoration: none;
}
.vn-choice-desc { color: var(--muted); font-size: .82rem; line-height: 1.5; margin-top: 2px; }
.vn-choice-arrow { color: var(--c); font-size: 1.8rem; font-weight: 700; opacity: .35; transition: opacity .2s, transform .2s; }
.vn-choice:hover .vn-choice-arrow, .vn-choice:focus-visible .vn-choice-arrow { opacity: 1; transform: translateX(4px); }

/* ---------- エンディング ---------- */
.vn-ending {
  backdrop-filter: blur(3px); background: rgba(15, 23, 42, .5); box-sizing: border-box; display: grid; inset: 0; opacity: 0;
  padding: 16px; place-items: center; pointer-events: none; position: fixed; transition: opacity .6s ease, visibility .6s; visibility: hidden;
}
.vn-ending.is-open { opacity: 1; pointer-events: auto; visibility: visible; }
.vn-ending-card {
  background: var(--paper); border-radius: 26px; box-shadow: 0 30px 80px rgba(0, 0, 0, .45); box-sizing: border-box;
  max-height: calc(100vh - 32px); overflow: auto; padding: 32px clamp(20px, 4vw, 44px) 28px; text-align: center; width: min(700px, 100%);
}
.vn-ending.is-open .vn-ending-card { animation: vn-rise .8s cubic-bezier(.2, .8, .2, 1) .1s both; }
.vn-ending-label { color: var(--blue); font-size: .74rem; font-weight: 700; letter-spacing: .24em; margin: 0; }
.vn-ending-card h2 { font-size: clamp(1.6rem, 3.6vw, 2.3rem); font-weight: 900; letter-spacing: .06em; margin: 6px 0 12px; }
.vn-ending-card p { line-height: 1.85; margin: 8px 0; }
.vn-ending-discuss { color: var(--muted); font-size: .9rem; }
.vn-ending-code {
  background: #eef4ff; border-left: 4px solid var(--blue); border-radius: 10px; color: var(--ink); font-size: .84rem;
  line-height: 1.7 !important; margin: 14px 0 0 !important; padding: 10px 14px; text-align: left;
}
.vn-ending-code b { color: var(--blue); display: block; font-size: .76rem; letter-spacing: .02em; }
.vn-ending-stats { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; display: grid; gap: 8px; margin: 18px 0 12px; padding: 14px 18px; text-align: left; }
.vn-ending-stat { align-items: center; display: grid; font-size: .84rem; gap: 12px; grid-template-columns: 7.5em 1fr 2.5em; }
.vn-ending-stat .vn-meter-bar { background: #e9edf3; height: 8px; margin: 0; }
.vn-ending-stat b { font-variant-numeric: tabular-nums; text-align: right; }
.vn-ending-collection { align-items: center; color: var(--muted); display: flex; flex-direction: column; font-size: .8rem; gap: 6px; margin: 4px 0 16px; }
.vn-dots { display: flex; gap: 6px; }
.vn-dots i { background: #dbe2ec; border-radius: 50%; display: block; height: 12px; width: 12px; }
.vn-dots i.is-seen { background: var(--blue); }
.vn-dots i.is-current { box-shadow: 0 0 0 3px rgba(47, 99, 214, .3); }

/* ボタン型リンク（はじめから・もう一度） */
.vn-btn {
  background: linear-gradient(120deg, #2f63d6, #1e4fb5); border-radius: 999px; box-shadow: 0 10px 24px rgba(47, 99, 214, .38);
  color: #fff; cursor: pointer; display: inline-block; font-size: 1.05rem; font-weight: 700; letter-spacing: .12em; padding: 13px 40px;
  text-decoration: none; transition: transform .2s ease, box-shadow .2s ease;
}
.vn-btn:hover, .vn-btn:focus-visible {
  box-shadow: 0 14px 30px rgba(47, 99, 214, .5); outline: none; transform: translateY(-2px);
}
.vn-btn::after { content: "  ▶"; font-size: .8em; }

/* ---------- タイトル画面 ---------- */
.vn-title {
  background: linear-gradient(90deg, rgba(248, 250, 252, .96) 0, rgba(248, 250, 252, .9) 38%, rgba(248, 250, 252, 0) 62%);
  box-sizing: border-box; inset: 0; overflow: auto; padding: clamp(16px, 4vh, 44px) clamp(16px, 4vw, 60px); pointer-events: auto; position: fixed;
}
.title-panel { animation: vn-rise .9s cubic-bezier(.2, .8, .2, 1) both; max-width: 640px; }
.title-eyebrow { color: var(--blue); font-size: .74rem; font-weight: 700; letter-spacing: .24em; margin: 0; }
.title-logo { color: var(--ink); font-size: clamp(2.4rem, 6vw, 4.2rem); font-weight: 900; letter-spacing: .06em; line-height: 1.08; margin: 8px 0 4px; }
.title-logo span span { display: block; }
.title-logo span span + span { color: var(--blue); padding-left: 1em; }
.title-en { color: var(--muted); font-size: .9rem; letter-spacing: .08em; margin: 0; }
.title-sub { font-size: clamp(.95rem, 1.5vw, 1.08rem); line-height: 1.7; margin: 12px 0 16px; }
.title-help { color: var(--muted); font-size: .78rem; margin: 10px 0 16px; }
.title-cards { display: grid; gap: 12px; grid-template-columns: 1.15fr 1fr; }
.title-side { display: grid; gap: 12px; }
.title-card {
  background: rgba(255, 255, 255, .88); border: 1px solid #e2e8f0; border-radius: 16px; box-shadow: 0 8px 22px rgba(30, 41, 59, .08);
  font-size: .84rem; line-height: 1.7; padding: 12px 16px;
}
.title-card h2 { color: var(--blue); font-size: .86rem; letter-spacing: .08em; margin: 0 0 4px; }
.title-card p { margin: 4px 0; }
.title-case { border-top: 1px dashed #cfd8e3; margin-top: 8px !important; padding-top: 8px; }
.title-case a { font-weight: 700; white-space: nowrap; }
.title-stats { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 4px 0; padding: 0; }
.title-stats li { border-radius: 99px; color: #fff; font-size: .74rem; font-weight: 700; padding: 2px 10px; }
.title-stats .s-trust { background: #22a487; }
.title-stats .s-runway { background: #d39a2b; }
.title-stats .s-team { background: #6b7fe0; }
.title-note { color: var(--muted); font-size: .72rem; }
.title-team ul { list-style: none; margin: 0; padding: 0; }
.title-team li::before { color: var(--blue); content: "● "; font-size: .7em; }
.title-team li { margin-top: 4px; }
.title-team li b { font-size: .86rem; }
.title-team li span[lang] { color: var(--muted); display: block; font-size: .74rem; line-height: 1.5; padding-left: 1.1em; }

/* ---------- 会話ログ ---------- */
.vn-log { background: rgba(15, 23, 42, .62); display: grid; inset: 0; padding: 16px; place-items: center; position: fixed; z-index: 10; }
.vn-log[hidden] { display: none; }
.vn-log-card {
  background: var(--paper); border-radius: 20px; box-shadow: 0 30px 80px rgba(0, 0, 0, .45); box-sizing: border-box; display: flex;
  flex-direction: column; font-family: var(--font); max-height: min(80vh, 720px); padding: 18px 22px; width: min(760px, 100%);
}
.vn-log-head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 8px; }
.vn-log-head h2 { font-size: 1.05rem; margin: 0; }
.vn-log-close { background: var(--ink); border: 0; border-radius: 99px; color: #fff; cursor: pointer; font: 700 .8rem var(--font); padding: 7px 16px; }
.vn-log-list { list-style: none; margin: 0; overflow: auto; padding: 0; }
.vn-log-list li { border-bottom: 1px solid #e5e9f0; display: grid; gap: 2px; line-height: 1.7; padding: 9px 2px; }
.vn-log-list li b { font-size: .8rem; }
.vn-log-list li p { margin: 0; }
.vn-log-list li.is-choice { color: var(--blue); font-weight: 700; }
.vn-log-list li.is-empty { color: var(--muted); }

/* ---------- アニメーション ---------- */
@keyframes vn-breathe { 0%, 100% { transform: scale(1, 1); } 50% { transform: scale(1.004, 1.009); } }
@keyframes vn-talk { from { transform: translateY(0); } to { transform: translateY(-5px); } }
@keyframes vn-pop { from { transform: translate(-50%, 5px); } to { transform: translate(-50%, 0); } }
@keyframes vn-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(3px); } }
@keyframes vn-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
@keyframes vn-choice-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
@keyframes vn-delta { 0% { opacity: 0; transform: translateY(-6px); } 12%, 75% { opacity: 1; transform: none; } 100% { opacity: 0; transform: translateY(4px); } }

/* ---------- レスポンシブ ---------- */
@media (max-width: 860px) {
  .vn-meter { width: 92px; }
  .vn-meter-label { font-size: .6rem; }
  .vn-place { display: none; }
  .vn-scene-tag { padding-right: 5px; }
  .title-cards { grid-template-columns: 1fr; }
  .vn-title { background: linear-gradient(180deg, rgba(248, 250, 252, .94), rgba(248, 250, 252, .86)); }
}
@media (max-width: 600px) {
  .vn-title { padding-top: 64px; }
  .vn-ending-ledger { grid-template-columns: 1fr; }
  .vn-ending { padding-top: 64px; }
  .vn-ending-card { max-height: calc(100vh - 80px); }
  :root { --box-h: 150px; }
  .vn-hud { flex-direction: column; left: 16px; right: 16px; }
  .vn-hud-right { width: 100%; }
  .vn-meters { flex: 1; gap: 8px; justify-content: space-between; padding: 6px 8px; }
  .vn-meter { flex: 1; width: auto; }
  .vn-meter-label { display: none; }
  .vn-log-btn span { display: none; }
  .vn-sprite-motion { height: 112vh; top: 12vh; }
  .vn-sprite[data-pos="left"] { left: 24%; }
  .vn-sprite[data-pos="right"] { left: 76%; }
  .vn-cast.is-title { opacity: .22; }
  .vn-box { padding: 30px 20px 30px; }
  .vn-box.has-face { padding-left: 20px; }
  .vn-box.has-face .vn-face { display: none; }
  .vn-box.has-face .vn-plate { left: 16px; }
  .vn-plate { left: 16px; }
  .vn-plate small { display: none; }
  .vn-next span { display: none; }
  .vn-choices { justify-content: flex-end; padding: 120px 16px calc(var(--box-h) + 40px); }
  .vn-choice { gap: 10px; grid-template-columns: auto minmax(0, 1fr); padding: 10px 12px 10px 14px; }
  .vn-choice-key, .vn-choice-arrow { display: none; }
  .vn-choice-icon { height: 38px; width: 38px; }
  .vn-choice-desc { font-size: .76rem; }
}
@media (max-height: 640px) {
  :root { --box-h: 130px; }
  .vn-box { padding-bottom: 20px; padding-top: 28px; }
  .vn-choices { padding-bottom: 24px; }
  .vn-stage.is-dim ~ .vn-ui .vn-box { opacity: 0; }
  .vn-choice-desc { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
